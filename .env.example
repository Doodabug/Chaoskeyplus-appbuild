# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=False

# Database — backend/server.py reads these names
MONGO_URL=mongodb://localhost:27017
DB_NAME=chaoskey_db
# Aliases also accepted: MONGODB_URL, DATABASE_NAME

# Frontend — frontend/src/lib/api.js reads REACT_APP_BACKEND_URL
REACT_APP_BACKEND_URL=http://localhost:8000
REACT_APP_ENV=development

# Starknet (Sepolia first). Do not put viewing keys or account private keys here.
# Copy frontend/.env.example for the full Pool-tab set.

# Telegram Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Deployment Settings
DEMO_REFRESH_INTERVAL=1800
MAX_TRANSACTION_RETRY=3

# API Security
API_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_CALLS=100
RATE_LIMIT_PERIOD=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log