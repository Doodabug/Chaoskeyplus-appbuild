# Entropy backend. Must match backend CORS origin + the running FastAPI host.
# Code reads REACT_APP_BACKEND_URL (REACT_APP_API_URL is accepted as a fallback).
REACT_APP_BACKEND_URL=http://localhost:8000

# Public Sepolia RPC — not a secret. Override if you run your own node.
REACT_APP_STARKNET_RPC=https://free-rpc.nethermind.io/sepolia-juno/v0_10

# STRK ERC-20 (same address on Sepolia and mainnet).
REACT_APP_STRK20_TOKEN=0x04718f5a0fc34cc1af16a1cdee98ffb20c31f5cd61d6ab07201858f4287c938d

# Optional. Sepolia privacy-pool address, used only to read get_fee_amount.
# Leave empty if you do not have it; the wallet still shows the fee at sign time.
REACT_APP_STRK20_POOL=

REACT_APP_STARKNET_EXPLORER=https://sepolia.voyager.online/tx
